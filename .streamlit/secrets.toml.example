# Streamlit Cloud secrets TEMPLATE. Copy the KEYS (not this file) into the
# Streamlit Cloud app's "Secrets" box at deploy time. NEVER commit real values —
# the real .streamlit/secrets.toml is gitignored.

GEMINI_API_KEY = ""

# Optional — X (Twitter) API v2 bearer token.
X_BEARER_TOKEN = ""

# Optional — Telegram API. On cloud you CANNOT use the .session file, so provide
# a StringSession instead (generate locally: python tools/export_session_string.py).
TELEGRAM_API_ID = ""
TELEGRAM_API_HASH = ""
TELEGRAM_STRING_SESSION = ""
