# Copy this file to .env and fill in your OWN keys. NEVER put real keys in this
# file — it is committed to git. Real keys go only in .env (which is gitignored).

# REQUIRED — free Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OPTIONAL — X (Twitter) API v2 bearer token. Without it, X sources are skipped
# and officials come via Bing relay. From developer.x.com.
X_BEARER_TOKEN=

# OPTIONAL — Telegram API (Telethon), from https://my.telegram.org.
# Without these, Telegram uses the t.me/s/ web preview (some channels disable it).
# After setting them, run ONCE in a terminal: python tools/telegram_login.py
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# OPTIONAL — CLOUD deploy only: a Telethon StringSession so Telegram works
# without the .session file (which can't be created on a headless server).
# Generate it locally with: python tools/export_session_string.py
TELEGRAM_STRING_SESSION=

# Optional overrides:
# MENA_GEMINI_MODEL=gemini-3.1-flash-lite
# MENA_HTTP_TIMEOUT=20
